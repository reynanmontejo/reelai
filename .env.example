# Use "mock" for deterministic local content or "supabase" for the public Supabase catalog.
NEXT_PUBLIC_REELAI_CONTENT_BACKEND=mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Phase 7A configuration. Never use NEXT_PUBLIC_ for these values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist of explicitly enabled external adapters.
# Available local adapters include reelai-demo, wikimedia-commons-ai,
# huggingface-deepaction, youtube-embed, dramafren-authorized,
# apify-netshort-metadata, dramabos-metadata, and apishort-metadata.
# Every adapter is opt-in and should be reviewed before production enablement.
REELAI_EXTERNAL_PROVIDERS=

# Server-only Apify metadata adapter. Never expose the token with NEXT_PUBLIC_.
APIFY_API_TOKEN=
APIFY_SHORT_DRAMA_ACTOR_ID=q4Bs4iFsMJwTOV2jH

# Server-only DramaBos metadata adapter. Playback stays disabled until rights
# for a specific catalog/provider are verified.
DRAMABOS_API_KEY=
DRAMABOS_SEARCH_PROVIDER=dramabox

# APIShort ShortMax catalog (server-only). Free key from https://apishort.com/login.
# The public catalog may accept no key; authenticated access is recommended.
APISHORT_API_KEY=
